rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================
    // 1. USERS
    // ========================
    match /users/{userId} {
      // Read dibuka untuk user login: transaksi escrow (laundry menimbang) perlu
      // membaca saldo customer. Juga dipakai customer untuk melihat daftar laundry.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Hapus akun sendiri
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Update data sendiri, ATAU khusus field 'balance' (untuk penyelesaian escrow
      // oleh laundry/driver saat menimbang & menyelesaikan order).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
      );
    }

    // ========================
    // 2. ORDERS
    // ========================
    match /orders/{orderId} {

      allow create: if request.auth != null &&
        request.resource.data.customerUid == request.auth.uid;

      // Pakai .get(field, default) agar aman untuk order yang belum punya
      // field driverUid/laundryUid (akses field tak-ada bikin rules error).
      allow read: if request.auth != null && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.get('driverUid', '') == request.auth.uid ||
        resource.data.get('laundryUid', '') == request.auth.uid
      );

      // Update order dibuka untuk semua user login: dipakai driver (accept/lepas/
      // antar), laundry (terima/timbang/selesai), dan customer (konfirmasi).
      // Alur transaksi & saldo tetap dijaga di sisi aplikasi.
      allow update: if request.auth != null;

      // Driver & laundry perlu query order (MENUNGGU_PICKUP / DI_LAUNDRY / miliknya)
      allow list: if request.auth != null && request.query.limit <= 100;
    }

    // ========================
    // 3. LAUNDRY PLANS (SMART PLANNER)
    // ========================
    match /laundry_plans/{planId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // ========================
    // 4. ESCROW SYSTEM
    // ========================
    match /system/escrow {
      allow read, write: if request.auth != null;
    }

    // ========================
    // 5. CHAT SUPPORT (customer <-> admin)
    // ChatViewModel memakai koleksi datar `chats` (tiap dokumen = 1 pesan) dan
    // meng-query seluruh koleksi, jadi dibuka untuk user terautentikasi.
    // ========================
    match /chats/{docId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // ========================
    // 6. CHAT ORDER (customer <-> driver, per-order)
    // Terbuka untuk user terautentikasi; hanya bisa mengirim atas nama diri sendiri.
    // ========================
    match /order_chats/{orderId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // Chat customer <-> laundry (per-laundry, id = "{customerUid}_{laundryUid}")
    match /laundry_chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // ========================
    // 7. SYSTEM DATA (READ ONLY)
    // ========================
    match /system/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
